<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="25dp"
        android:paddingTop="12dp"
        android:paddingRight="25dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <Spinner
            android:id="@+id/settings.locale"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingRight="25dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="left"
                android:id="@+id/settings.soundeffects"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <SeekBar
                android:id="@+id/settings.effectsvolume"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:max="100"
                android:indeterminate="false"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingRight="25dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="left"
                android:id="@+id/settings.music"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <SeekBar
                android:id="@+id/settings.musicvolume"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:max="100"
                android:indeterminate="false"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingRight="25dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="left"
                android:id="@+id/settings.tameralertstext"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <ToggleButton
                android:id="@+id/settings.tammeralerts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="80dp"
                android:textOn="On"
                android:textOff="Off"/>
        </LinearLayout>
        <TextView
            android:textStyle="bold"
            android:textColor="#76abf2"
            android:id="@+id/settings.tamerrecharged"
            android:paddingBottom="10dp"
            android:layout_width="350dp"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:textSize="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="left"
                android:id="@+id/settings.dalyprizestext"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <ToggleButton
                android:id="@+id/settings.dailyprizesalert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="80dp"
                android:textOn="On"
                android:textOff="Off"/>
        </LinearLayout>
        <TextView
            android:textStyle="bold"
            android:textColor="#76abf2"
            android:id="@+id/settings.dontmissdailyprize"
            android:paddingBottom="10dp"
            android:layout_width="300dp"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:textSize="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="left"
                android:id="@+id/settings.mogarested"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <ToggleButton
                android:id="@+id/settings.mogarestedalert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="80dp"
                android:textOn="On"
                android:textOff="Off"/>
        </LinearLayout>
        <TextView
            android:textStyle="bold"
            android:textColor="#76abf2"
            android:id="@+id/settings.findaoutmogas"
            android:paddingBottom="10dp"
            android:layout_width="300dp"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:textSize="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="left"
                android:id="@+id/settings.storyalerts"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <ToggleButton
                android:id="@+id/settings.islandalerts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="80dp"
                android:textOn="On"
                android:textOff="Off"/>
        </LinearLayout>
        <TextView
            android:textStyle="bold"
            android:textColor="#76abf2"
            android:id="@+id/settings.islandalertstext"
            android:paddingBottom="10dp"
            android:layout_width="300dp"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center"
            android:padding="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/logo"/>
        <TextView
            android:textStyle="bold"
            android:textColor="#fff"
            android:gravity="center"
            android:id="@+id/settings.desingedbygaia"
            android:paddingTop="5dp"
            android:paddingBottom="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textStyle="bold"
            android:textColor="#fff"
            android:gravity="center"
            android:id="@+id/settings.gaiainfo"
            android:paddingTop="0dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textStyle="bold"
            android:textColor="#fff"
            android:textColorLink="#e8e416"
            android:gravity="center"
            android:autoLink="web"
            android:id="@+id/settings.visittext"
            android:paddingLeft="77dp"
            android:paddingTop="10dp"
            android:paddingRight="77dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textStyle="bold"
            android:textColor="#fff"
            android:textColorLink="#e8e416"
            android:gravity="right"
            android:layout_gravity="right"
            android:id="@+id/settings.version"
            android:paddingRight="20dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-30dp"
            android:text="v X.XX"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="#fff"
            android:gravity="right"
            android:id="@+id/settings.udid"
            android:paddingTop="45dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UDID"/>
    </LinearLayout>
</ScrollView>
