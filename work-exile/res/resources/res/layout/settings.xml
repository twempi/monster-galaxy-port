<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="25dp"
            android:paddingTop="10dp"
            android:paddingRight="25dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="left"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sound Effects"
                android:layout_weight="1"/>
            <SeekBar
                android:id="@+id/settings.effectsvolume"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:max="100"
                android:indeterminate="false"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="25dp"
            android:paddingTop="10dp"
            android:paddingRight="25dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="left"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Music"
                android:layout_weight="1"/>
            <SeekBar
                android:id="@+id/settings.musicvolume"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:max="100"
                android:indeterminate="false"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="25dp"
            android:paddingTop="10dp"
            android:paddingRight="25dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="left"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tamer Alerts"
                android:layout_weight="1"/>
            <ToggleButton
                android:id="@+id/settings.tammeralerts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="80dp"
                android:textOn="On"
                android:textOff="Off"/>
        </LinearLayout>
        <TextView
            android:textStyle="bold"
            android:textColor="#76abf2"
            android:paddingLeft="25dp"
            android:paddingBottom="10dp"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:text="Find out when your tamer is recharged and ready to go!"/>
        <LinearLayout
            android:textSize="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="25dp"
            android:paddingTop="10dp"
            android:paddingRight="25dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="left"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Daily Prizes Alerts"
                android:layout_weight="1"/>
            <ToggleButton
                android:id="@+id/settings.dailyprizesalert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="80dp"
                android:textOn="On"
                android:textOff="Off"/>
        </LinearLayout>
        <TextView
            android:textStyle="bold"
            android:textColor="#76abf2"
            android:paddingLeft="25dp"
            android:paddingBottom="10dp"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:text="Don&apos;t miss out on Daily Prize - find out as soon as it&apos;s available!"/>
        <LinearLayout
            android:textSize="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="25dp"
            android:paddingTop="10dp"
            android:paddingRight="25dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="left"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Moga Rested"
                android:layout_weight="1"/>
            <ToggleButton
                android:id="@+id/settings.mogarestedalert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="80dp"
                android:textOn="On"
                android:textOff="Off"/>
        </LinearLayout>
        <TextView
            android:textStyle="bold"
            android:textColor="#76abf2"
            android:paddingLeft="25dp"
            android:paddingBottom="10dp"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:text="Find out as soon as your Mogas are rested and ready for adventure."/>
        <LinearLayout
            android:textSize="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="25dp"
            android:paddingTop="10dp"
            android:paddingRight="25dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="left"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Story alerts"
                android:layout_weight="1"/>
            <ToggleButton
                android:id="@+id/settings.islandalerts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="80dp"
                android:textOn="On"
                android:textOff="Off"/>
        </LinearLayout>
        <TextView
            android:textStyle="bold"
            android:textColor="#76abf2"
            android:paddingLeft="25dp"
            android:paddingBottom="10dp"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:text="Receive stories from island characters."/>
        <ImageView
            android:layout_gravity="center"
            android:padding="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/logo"/>
        <TextView
            android:textStyle="bold"
            android:textColor="#fff"
            android:gravity="center"
            android:paddingLeft="25dp"
            android:paddingTop="5dp"
            android:paddingRight="25dp"
            android:paddingBottom="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Designed, developed, and published by Gaia Interactive."/>
        <TextView
            android:textStyle="bold"
            android:textColor="#fff"
            android:gravity="center"
            android:paddingLeft="25dp"
            android:paddingTop="0dp"
            android:paddingRight="25dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="© 2011 Gaia Interactive, Inc."/>
        <TextView
            android:textStyle="bold"
            android:textColor="#fff"
            android:textColorLink="#e8e416"
            android:gravity="center"
            android:autoLink="web"
            android:paddingLeft="77dp"
            android:paddingTop="10dp"
            android:paddingRight="77dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Visit http://www.gaiaonline.com/monsterg for more information and customer service."/>
        <TextView
            android:textStyle="bold"
            android:textColor="#fff"
            android:textColorLink="#e8e416"
            android:gravity="right"
            android:layout_gravity="right"
            android:id="@+id/settings.version"
            android:paddingRight="20dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-30dp"
            android:text="v X.XX"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="#fff"
            android:gravity="right"
            android:id="@+id/settings.udid"
            android:paddingTop="45dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UDID"/>
    </LinearLayout>
</ScrollView>
