<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="top|left"
    android:background="#000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="25dp"
            android:paddingTop="10dp"
            android:paddingRight="25dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="left"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tweaks status"
                android:layout_weight="1"/>
            <ToggleButton
                android:id="@+id/tweaks.enable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:textOn="On"
                android:textOff="Off"/>
        </LinearLayout>
        <TextView
            android:textStyle="bold"
            android:textColor="#76abf2"
            android:paddingLeft="25dp"
            android:paddingBottom="10dp"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:text="Whether to enable all tweaks."/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/tweaks.otheroptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingLeft="25dp"
                android:paddingTop="10dp"
                android:paddingRight="25dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="24dp"
                    android:textStyle="bold"
                    android:textColor="#fff"
                    android:gravity="left"
                    android:paddingRight="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Blue coffees"
                    android:layout_weight="1"/>
                <EditText
                    android:id="@+id/tweaks.bluecoffees"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:inputType="number"
                    android:imeOptions="flagNoExtractUi"/>
            </LinearLayout>
            <TextView
                android:textStyle="bold"
                android:textColor="#76abf2"
                android:paddingLeft="25dp"
                android:paddingBottom="10dp"
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:text="Change the amount of blue coffees that the tamer has."/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingLeft="25dp"
                android:paddingTop="10dp"
                android:paddingRight="25dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="24dp"
                    android:textStyle="bold"
                    android:textColor="#fff"
                    android:gravity="left"
                    android:paddingRight="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Starseeds"
                    android:layout_weight="1"/>
                <EditText
                    android:id="@+id/tweaks.starseeds"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:inputType="number"
                    android:imeOptions="flagNoExtractUi"/>
            </LinearLayout>
            <TextView
                android:textStyle="bold"
                android:textColor="#76abf2"
                android:paddingLeft="25dp"
                android:paddingBottom="10dp"
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:text="Change the amount of starseeds that the tamer has."/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingLeft="25dp"
                android:paddingTop="10dp"
                android:paddingRight="25dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="24dp"
                    android:textStyle="bold"
                    android:textColor="#fff"
                    android:gravity="left"
                    android:paddingRight="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Moga cash"
                    android:layout_weight="1"/>
                <EditText
                    android:id="@+id/tweaks.mogacash"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:inputType="number"
                    android:imeOptions="flagNoExtractUi"/>
            </LinearLayout>
            <TextView
                android:textStyle="bold"
                android:textColor="#76abf2"
                android:paddingLeft="25dp"
                android:paddingBottom="10dp"
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:text="Change the amount of coins (moga cash) that the tamer has."/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingLeft="25dp"
                android:paddingTop="10dp"
                android:paddingRight="25dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="24dp"
                    android:textStyle="bold"
                    android:textColor="#fff"
                    android:gravity="left"
                    android:paddingRight="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rival starting energy"
                    android:layout_weight="1"/>
                <ToggleButton
                    android:id="@+id/tweaks.customrivalstartingenergy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:textOn="Custom"
                    android:textOff="Default"/>
                <EditText
                    android:id="@+id/tweaks.rivalstartingenergy"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:inputType="number"
                    android:imeOptions="flagNoExtractUi"/>
            </LinearLayout>
            <TextView
                android:textStyle="bold"
                android:textColor="#76abf2"
                android:paddingLeft="25dp"
                android:paddingBottom="10dp"
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:text="Change the amount of health points that each computer moga will have at the beginning of each battle."/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="25dp"
            android:paddingTop="10dp"
            android:paddingRight="25dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/tweaks.save"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:text="Save"/>
            <Button
                android:id="@+id/tweaks.cancel"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:text="Cancel"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="25dp"
            android:paddingTop="10dp"
            android:paddingRight="25dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="left"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Auto play"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/tweaks.autoplay"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:text="Pick island"/>
        </LinearLayout>
        <TextView
            android:textStyle="bold"
            android:textColor="#76abf2"
            android:paddingLeft="25dp"
            android:paddingBottom="10dp"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:text="Fights all the battles required to complete a given island."/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="25dp"
            android:paddingTop="10dp"
            android:paddingRight="25dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="#fff"
                android:gravity="left"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Snapshots"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/tweaks.savesnap"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:text="Save"/>
            <Button
                android:id="@+id/tweaks.loadsnap"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:text="Load"/>
        </LinearLayout>
        <TextView
            android:textStyle="bold"
            android:textColor="#76abf2"
            android:paddingLeft="25dp"
            android:paddingBottom="10dp"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:text="Allows saving current game state to SD card and loading game states from it."/>
    </LinearLayout>
</ScrollView>
